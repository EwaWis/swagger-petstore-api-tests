{
  "name": "petstore-api-tests",
  "version": "1.0.0",
  "description": "Automated API tests for Petstore /pet resource using Playwright + TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "report": "playwright show-report",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
